import { useState } from 'react';
import { Search, Loader2, CheckCircle2, ArrowRight } from 'lucide-react';

export default function Audit() {
  const [url, setUrl] = useState('');
  const [status, setStatus] = useState<'idle' | 'loading' | 'success' | 'error'>('idle');
  const [progress, setProgress] = useState(0);
  const [results, setResults] = useState<{
    performance: number;
    seo: number;
    accessibility: number;
    bestPractices: number;
  } | null>(null);

  const handleAudit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!url) return;

    // Normalize URL
    let targetUrl = url;
    if (!targetUrl.startsWith('http')) {
      targetUrl = 'https://' + targetUrl;
    }

    setStatus('loading');
    setProgress(10);

    try {
      // Phase 1: Initiation
      const interval = setInterval(() => {
        setProgress((prev) => {
          if (prev >= 90) {
            clearInterval(interval);
            return 90;
          }
          return prev + 0.5;
        });
      }, 200);

      // Real API Call (PageSpeed Insights)
      // Using a public proxy or direct if key is available. 
      // For now, we'll try to use the key from env or a fallback if not set yet for demonstration
      const apiKey = import.meta.env.VITE_PAGESPEED_API_KEY || '';
      const response = await fetch(
        `https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url=${encodeURIComponent(targetUrl)}&category=performance&category=seo&category=accessibility&category=best-practices${apiKey ? `&key=${apiKey}` : ''}`
      );

      if (!response.ok) throw new Error('Analyse fehlgeschlagen');

      const data = await response.json();
      const categories = data.lighthouseResult.categories;

      setResults({
        performance: Math.round(categories.performance.score * 100),
        seo: Math.round(categories.seo.score * 100),
        accessibility: Math.round(categories.accessibility.score * 100),
        bestPractices: Math.round(categories['best-practices'].score * 100),
      });

      clearInterval(interval);
      setProgress(100);
      setTimeout(() => setStatus('success'), 500);

    } catch (error) {
      console.error('Audit error:', error);
      setStatus('error');
    }
  };

  return (
    <section id="audit" className="bg-gl-dark py-20 border-y border-white/5 relative overflow-hidden">
      {/* Background Glow */}
      <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gl-green/5 blur-[120px] rounded-full pointer-events-none" />

      <div className="max-w-[1200px] mx-auto px-6 relative z-10">
        <div className="text-center mb-12">
          <p className="font-mono text-gl-green font-bold tracking-[0.2em] text-[10px] uppercase mb-3">
            KOSTENLOSE FEHLERANALYSE
          </p>
          <h2 className="text-3xl md:text-4xl font-bold text-white mb-6">
            Verbrennt deine Website jeden Tag bares Geld?
          </h2>
          <p className="text-gl-gray-light max-w-2xl mx-auto">
            Gib deine URL ein und erhalte in Echtzeit echte Daten von Google über deine Website-Performance.
          </p>
        </div>

        <div className="max-w-4xl mx-auto">
          {status === 'idle' && (
            <form onSubmit={handleAudit} className="flex flex-col md:flex-row gap-4">
              <div className="flex-1 relative">
                <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gl-gray" />
                <input
                  type="text"
                  placeholder="deine-website.de"
                  className="w-full bg-white/5 border border-white/10 rounded-xl py-4 pl-12 pr-4 text-white focus:outline-none focus:border-gl-green/50 transition-colors"
                  value={url}
                  onChange={(e) => setUrl(e.target.value)}
                  required
                />
              </div>
              <button 
                type="submit"
                className="bg-gl-green hover:bg-gl-green-hover text-black font-bold px-8 py-4 rounded-xl transition-all flex items-center justify-center gap-2"
              >
                Jetzt Echtzeit-Scan starten
                <ArrowRight className="w-5 h-5" />
              </button>
            </form>
          )}

          {status === 'loading' && (
            <div className="bg-white/5 border border-white/10 rounded-2xl p-8 text-center backdrop-blur-sm">
              <div className="mb-6 relative h-2 bg-white/10 rounded-full overflow-hidden">
                <div 
                  className="absolute top-0 left-0 h-full bg-gl-green shadow-[0_0_15px_rgba(0,204,106,0.5)] transition-all duration-300"
                  style={{ width: `${progress}%` }}
                />
              </div>
              <div className="flex items-center justify-center gap-3 text-white font-medium">
                <Loader2 className="w-5 h-5 animate-spin text-gl-green" />
                <span>Analysiere <span className="text-gl-green">{url}</span> direkt über Google...</span>
              </div>
              <p className="text-gl-gray-light text-xs mt-4">Dies kann bis zu 20 Sekunden dauern.</p>
            </div>
          )}

          {status === 'error' && (
            <div className="bg-red-500/10 border border-red-500/20 rounded-2xl p-8 text-center">
              <h3 className="text-xl font-bold text-red-500 mb-2">Ups! Da ist was schiefgelaufen.</h3>
              <p className="text-gl-gray-light mb-6">Wir konnten die Website nicht erreichen oder die Analyse wurde blockiert.</p>
              <button 
                onClick={() => setStatus('idle')}
                className="bg-white/10 hover:bg-white/20 text-white px-6 py-2 rounded-lg transition-colors"
              >
                Erneut versuchen
              </button>
            </div>
          )}

          {status === 'success' && results && (
            <div className={`glass-card rounded-[2.5rem] p-8 md:p-12 animate-in fade-in zoom-in duration-700 shadow-2xl backdrop-blur-2xl relative overflow-hidden ${results.performance >= 90 ? 'ring-2 ring-gl-green/20' : ''}`}>
              {/* Internal Glow for high scores */}
              {results.performance >= 90 && (
                <div className="absolute inset-0 bg-gl-green/5 animate-pulse pointer-events-none" />
              )}

              <div className="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12 relative z-10">
                {[
                  { label: 'Performance', score: results.performance },
                  { label: 'SEO', score: results.seo },
                  { label: 'Accessibility', score: results.accessibility },
                  { label: 'Best Practices', score: results.bestPractices },
                ].map((item, idx) => (
                  <div key={item.label} className="text-center group" style={{ animationDelay: `${idx * 150}ms` }}>
                    <div className="relative inline-flex items-center justify-center mb-6">
                      <svg className="w-24 h-24 md:w-28 md:h-28 transform -rotate-90">
                        <circle
                          cx="50%" cy="50%" r="42%"
                          className="stroke-white/5 fill-none"
                          strokeWidth="8"
                        />
                        <circle
                          cx="50%" cy="50%" r="42%"
                          className={`fill-none transition-all duration-[1.5s] ease-out ${
                            item.score >= 90 ? 'stroke-gl-green shadow-[0_0_15px_rgba(0,204,106,0.5)]' : item.score >= 50 ? 'stroke-yellow-500' : 'stroke-red-500'
                          }`}
                          strokeWidth="8"
                          strokeDasharray="251.2"
                          strokeDashoffset={251.2 - (251.2 * item.score) / 100}
                          strokeLinecap="round"
                        />
                      </svg>
                      <span className="absolute text-2xl md:text-3xl font-black text-white group-hover:scale-125 transition-transform duration-500">
                        {item.score}
                      </span>
                    </div>
                    <p className="text-[10px] md:text-xs font-black uppercase tracking-[0.2em] text-gl-gray-light group-hover:text-gl-green transition-colors">
                      {item.label}
                    </p>
                  </div>
                ))}
              </div>

              <div className="text-center border-t border-white/10 pt-10 relative z-10">
                <h3 className="text-2xl font-black text-white mb-4">Ergebnis für {url}</h3>
                <p className="text-gl-gray-light mb-10 max-w-xl mx-auto">
                  {results.seo < 90 || results.performance < 90 
                    ? "Wir haben kritische Fehler gefunden, die dich Rankings und Kunden kosten. Lass uns diese gemeinsam beheben."
                    : "Deine Seite sieht gut aus, aber es gibt noch ungenutzte Conversion-Potenziale. Lass uns dein Business skalieren."}
                </p>
                <div className="flex flex-col sm:flex-row items-center justify-center gap-4">
                  <a 
                    href="#kontakt"
                    className="w-full sm:w-auto bg-gl-green hover:bg-gl-green-hover text-black font-black px-10 py-5 rounded-full transition-all shadow-[0_10px_40px_-10px_rgba(0,204,106,0.4)]"
                  >
                    Kostenlose Strategie-Session
                  </a>
                  <button 
                    onClick={() => setStatus('idle')}
                    className="w-full sm:w-auto text-gl-gray-light hover:text-white transition-colors text-xs font-mono uppercase tracking-widest"
                  >
                    Andere Seite prüfen
                  </button>
                </div>
              </div>
            </div>
          )}
        </div>

        {/* Benefits Grid */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mt-24 md:mt-16">
          <div className="flex items-start gap-4 p-5 rounded-xl bg-white/[0.03] border border-white/5">
            <CheckCircle2 className="w-6 h-6 text-gl-green shrink-0 mt-0.5" />
            <div>
              <h4 className="text-white font-bold text-base mb-2">Google-Blindflug</h4>
              <p className="text-gray-300 text-sm leading-relaxed">Wir decken auf, warum du bei den wichtigsten Suchbegriffen unsichtbar bleibst und wertvolle Anfragen verschenkst.</p>
            </div>
          </div>
          <div className="flex items-start gap-4 p-5 rounded-xl bg-white/[0.03] border border-white/5">
            <CheckCircle2 className="w-6 h-6 text-gl-green shrink-0 mt-0.5" />
            <div>
              <h4 className="text-white font-bold text-base mb-2">Heimlicher Besucher-Verlust</h4>
              <p className="text-gray-300 text-sm leading-relaxed">Langsame Seiten töten Anfragen. Finde heraus, ob ungeduldige Kunden abspringen, bevor sie dein Angebot überhaupt sehen.</p>
            </div>
          </div>
          <div className="flex items-start gap-4 p-5 rounded-xl bg-white/[0.03] border border-white/5">
            <CheckCircle2 className="w-6 h-6 text-gl-green shrink-0 mt-0.5" />
            <div>
              <h4 className="text-white font-bold text-base mb-2">Verkaufs-Blockaden</h4>
              <p className="text-gray-300 text-sm leading-relaxed">Wir zeigen dir genau, warum Leute deine Website zwar besuchen, dich aber am Ende trotzdem nicht anrufen.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  );
}
